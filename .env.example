# Gmail SMTP (contraseña de aplicación — https://myaccount.google.com/apppasswords)
GOOGLE_MAIL_USER=tu-cuenta@gmail.com
GOOGLE_MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Nombre visible en el remitente (opcional)
MAIL_FROM_NAME=Chullos Tours

# Correos del equipo que reciben leads (coma-separados). Por defecto: reservas + info de company-info.json
ADMIN_EMAIL=reservas@chullostours.com,info@chullostours.com

# URL pública del sitio (Coolify / producción)
NEXT_PUBLIC_SITE_URL=https://chullostours.com

# Tipo de cambio PEN por 1 USD (opcional; sobrescribe company-info.json)
EXCHANGE_RATE_PEN=3.75
